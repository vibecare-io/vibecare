#!/usr/bin/env bash
set -euo pipefail

# VibeCare PKG Postinstall Script
# Installs and starts the VibeCare backend service as a user LaunchAgent

# Get the actual console user (not root)
CONSOLE_USER=$(stat -f "%Su" /dev/console)
USER_HOME="/Users/${CONSOLE_USER}"
LAUNCH_AGENTS_DIR="${USER_HOME}/Library/LaunchAgents"
PLIST_NAME="io.vibecare.server.plist"
USER_UID=$(id -u "${CONSOLE_USER}")

log() {
    echo "[VibeCare Installer] $1"
}

log "Installing VibeCare backend service for user: ${CONSOLE_USER}"

# Create VibeCare logs directory (required by LaunchAgent)
VIBECARE_LOGS_DIR="${USER_HOME}/.vibecare/logs"
log "Creating logs directory..."
mkdir -p "${VIBECARE_LOGS_DIR}"
chown -R "${CONSOLE_USER}:staff" "${USER_HOME}/.vibecare"

# Copy LaunchAgent plist
log "Installing LaunchAgent..."
cp "/tmp/vibecare-install/${PLIST_NAME}" "${LAUNCH_AGENTS_DIR}/${PLIST_NAME}"

# Replace ~ with actual home directory in plist
sed -i '' "s|~|${USER_HOME}|g" "${LAUNCH_AGENTS_DIR}/${PLIST_NAME}"

# Set ownership to console user
chown "${CONSOLE_USER}:staff" "${LAUNCH_AGENTS_DIR}/${PLIST_NAME}"

# Load LaunchAgent using modern bootstrap command
log "Starting VibeCare backend service..."
launchctl bootout "gui/${USER_UID}/io.vibecare.server" 2>/dev/null || true
launchctl bootstrap "gui/${USER_UID}" "${LAUNCH_AGENTS_DIR}/${PLIST_NAME}"

# Wait for server to start
log "Waiting for backend to start..."
sleep 3

# Check if backend is running
if curl -s http://localhost:8080/status > /dev/null 2>&1; then
    log "✓ VibeCare backend is running"
else
    log "⚠ Backend may not have started yet. It will start automatically."
    log "  Check logs: ${USER_HOME}/.vibecare/logs/server-error.log"
fi

# Cleanup
rm -rf /tmp/vibecare-install

log ""
log "Installation complete!"
log "- Backend server: http://localhost:8080"
log "- gRPC endpoint: localhost:50051"
log "- Data directory: ${USER_HOME}/.vibecare"
log "- Logs: ${USER_HOME}/.vibecare/logs/"
log ""
log "To start the macOS client, open VibeCare from Applications"
log ""
log "To stop the backend:"
log "  launchctl bootout gui/${USER_UID}/io.vibecare.server"
log "To start the backend:"
log "  launchctl bootstrap gui/${USER_UID} ~/Library/LaunchAgents/${PLIST_NAME}"

exit 0
