.build/
# Build output. `just build-vibecheck-plugin` stages the binary and its
# SwiftPM resource bundle here, in a directory that holds nothing else —
# see that recipe for why the plugin root cannot hold the binary itself.
/dist/
# Pre-dist build output. Nothing writes these any more; still ignored so a
# stale copy from an older checkout doesn't surface as untracked noise.
/vibecheck
/vibecheck_vibecheck.bundle
